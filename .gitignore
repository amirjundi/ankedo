# =============================================================================
# AnkEdo — Hate Speech Monitoring Agent
# .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# SPEC-KIT & PLANNING ARTIFACTS (never publish to public repo)
# -----------------------------------------------------------------------------
specs/
.agents/
.specify/
hate-speech-agent-requirements.md

# -----------------------------------------------------------------------------
# SECRETS & LOCAL CONFIGURATION (never publish)
# -----------------------------------------------------------------------------
.env
*.env
config/accounts.json
config/secrets.json
data/credentials/

# -----------------------------------------------------------------------------
# RUNTIME DATA (generated at runtime, not source-controlled)
# -----------------------------------------------------------------------------
data/
evidence/
screenshots/
*.sqlite
*.db
*.db-shm
*.db-wal
logs/
*.log

# -----------------------------------------------------------------------------
# PYTHON
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# Virtual environments
.venv/
venv/
env/
ENV/
.env/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Type checking & linting
.mypy_cache/
.ruff_cache/
.dmypy.json

# -----------------------------------------------------------------------------
# BROWSER / PLAYWRIGHT
# -----------------------------------------------------------------------------
# Playwright browser binaries (installed at runtime via playwright install)
playwright-browsers/
ms-playwright/

# Browser session data (contains auth tokens — never commit)
sessions/

# `ankedo backup` output — contains the database and evidence screenshots, i.e.
# collected content about real people. Never versioned.
backups/
fingerprints/
cookies/

# -----------------------------------------------------------------------------
# OS FILES
# -----------------------------------------------------------------------------
# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~

# -----------------------------------------------------------------------------
# EDITORS & IDEs
# -----------------------------------------------------------------------------
.vscode/settings.json
.vscode/launch.json
.idea/
*.swp
*.swo
*.sublime-workspace

# Keep these (shared dev config)
!.vscode/extensions.json
!.vscode/tasks.json

# -----------------------------------------------------------------------------
# INSTALLER / BUILD ARTIFACTS
# -----------------------------------------------------------------------------
installer/build/
*.msi
*.exe
*.dmg

# -----------------------------------------------------------------------------
# WHAT IS INTENTIONALLY TRACKED (override rules above if needed)
# -----------------------------------------------------------------------------
# Source code:          src/
# Bootstrap scripts:    install.ps1, install.sh
# Dependency manifest:  pyproject.toml, requirements.txt, requirements.lock
# Example config:       .env.example, config/*.example.json
# Documentation:        README.md, CHANGELOG.md, LICENSE
# CI/CD:                .github/

# Ensure example configs are always tracked even if *.json would be ignored
!config/*.example.json
!.env.example
