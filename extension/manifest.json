{
  "manifest_version": 3,
  "name": "AnkEdo Capture",
  "version": "0.1.0",
  "description": "Send the post you are reading to your local AnkEdo agent for hate-speech classification.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Capture this post"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {}
}
