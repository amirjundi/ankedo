# AnkEdo — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it is in .gitignore.

# ---------------------------------------------------------------------------
# LLM Provider
# ---------------------------------------------------------------------------
# "gemini" or "openai". Gemini is recommended: it is the only one where the client
# can disable the safety filters that would otherwise block the hate speech this
# tool exists to read, and the only one where the fixed seed is honoured (FR-CL-13).
LLM_PROVIDER=gemini

# Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# OpenAI-compatible (only read when LLM_PROVIDER=openai). The base URL selects the
# service; leave it empty for OpenAI itself. Known-good values:
#   OpenRouter  https://openrouter.ai/api/v1
#   Groq        https://api.groq.com/openai/v1
#   Together    https://api.together.xyz/v1
#   DeepSeek    https://api.deepseek.com/v1
#   Ollama      http://localhost:11434/v1
#   LM Studio   http://localhost:1234/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Model assignments (one per agent role — change with `ankedo configure set`).
# Verify current model IDs at ai.google.dev/gemini-api/docs/models before editing.
TRIAGE_MODEL=gemini-3.5-flash-lite       # Fast, cheap — filters obvious non-hate-speech
SPECIALIST_MODEL=gemini-3.6-flash        # Deep Arabic/Kurdish cultural analysis
CRITIC_MODEL=gemini-3.5-flash-lite       # Anti-hallucination review
VISION_MODEL=gemini-3.6-flash            # Image and video analysis
CHAT_AGENT_MODEL=gemini-3.6-flash        # Conversational chat with admin

# ---------------------------------------------------------------------------
# Ettok Platform (owns the lexicon and the review queue)
# ---------------------------------------------------------------------------
ETTOK_BASE_URL=                   # e.g. https://ettok.net/api/hermes/
ETTOK_AGENT_KEY=                  # Bearer key with the hate_speech_scan scope
ETTOK_AGENT_ID=                   # Sent as X-Agent-Id; defaults to ankedo-<hostname>

# ---------------------------------------------------------------------------
# Browser
# ---------------------------------------------------------------------------
# Playwright will not download a browser for a distro its build registry does not
# know yet (Ubuntu 26.04 hits this). Point it at one already installed instead.
# `ankedo doctor --fix` fills this in automatically when it finds one.
BROWSER_EXECUTABLE_PATH=
BROWSER_CHANNEL=                        # or an installed channel: chrome, chromium

# ---------------------------------------------------------------------------
# Chrome extension (optional, off by default)
# ---------------------------------------------------------------------------
# Lets you capture the post you are reading in your own logged-in browser and send
# it to the agent. The endpoints are not mounted at all unless this is true.
EXTENSION_ENABLED=false
# chrome://extensions shows the id after you load the extension/ directory unpacked.
EXTENSION_ORIGIN=                       # e.g. chrome-extension://abcdefgh...

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./data/ankedo.db
# Path where the SQLite file will be created (relative to project root)
DATA_DIR=./data

# ---------------------------------------------------------------------------
# Agent Behavior — Crawling & Thresholds
# ---------------------------------------------------------------------------
# How often the orchestration loop runs (seconds)
LOOP_INTERVAL_SECONDS=60

# Classification confidence threshold to auto-route to review queue (0.0–1.0)
AUTO_FLAG_THRESHOLD=0.75

# Borderline confidence range (items in this range are batched, not immediately escalated)
BORDERLINE_LOW=0.50
BORDERLINE_HIGH=0.74

# Maximum items to send to reviewer per review batch (prevents overload)
MAX_REVIEW_BATCH_SIZE=25

# ---------------------------------------------------------------------------
# Autonomous Discovery — Autonomy Levels
# ---------------------------------------------------------------------------
# Max accounts the agent can auto-add to watch list per cycle (0 = ask admin always)
AUTO_ADD_ACCOUNTS_PER_CYCLE=5

# ---------------------------------------------------------------------------
# Crawl Rate Limits
# ---------------------------------------------------------------------------
# Minimum delay between actions in a browser session (seconds, Gaussian distributed)
PACING_MIN_DELAY_SECONDS=2.5
PACING_MAX_DELAY_SECONDS=8.0

# ---------------------------------------------------------------------------
# Queue — Backpressure
# ---------------------------------------------------------------------------
# Classification queue high-water mark — discovery slows when this is exceeded
CLASSIFICATION_QUEUE_HIGH_WATER=500

# ---------------------------------------------------------------------------
# Case Lifecycle Thresholds
# ---------------------------------------------------------------------------
# Hours of declining activity before case moves from Active → Cooling
COOLING_THRESHOLD_HOURS=24

# Days in Cooling before case moves to Dormant
DORMANT_THRESHOLD_DAYS=7

# ---------------------------------------------------------------------------
# Learning Loop
# ---------------------------------------------------------------------------
# Regression threshold: block deployment if any group drops more than N pp
REGRESSION_MAX_DROP_PP=2.0

# Minimum gold eval set size required before eval gate activates
GOLD_EVAL_MIN_SIZE=100

# ---------------------------------------------------------------------------
# Notifications & Admin Communication
# ---------------------------------------------------------------------------
# Timeout before a notification is re-sent with escalated urgency (minutes)
NOTIFICATION_TIMEOUT_MINUTES=30

# Escalation re-notification interval (minutes)
ESCALATION_INTERVAL_MINUTES=60

# ---------------------------------------------------------------------------
# Telegram Bot
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=                     # From @BotFather
TELEGRAM_ADMIN_CHAT_ID=                 # Your personal Telegram chat ID

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Random 32+ character secret used to encrypt channel credentials at rest
SECRET_KEY=                             # Generate with: python -c "import secrets; print(secrets.token_hex(32))"

# ---------------------------------------------------------------------------
# API Server
# ---------------------------------------------------------------------------
API_HOST=127.0.0.1                      # 0.0.0.0 exposes the dashboard to the network
API_PORT=8000

# Whether `ankedo start` also runs the collection/classification loop. True by
# default, because a "start" that serves a dashboard and collects nothing is how
# an agent looks healthy while doing no work at all.
RUN_AGENT_WITH_API=true

# ---------------------------------------------------------------------------
# Evidence & Screenshots
# ---------------------------------------------------------------------------
EVIDENCE_DIR=./evidence
SCREENSHOT_FORMAT=png

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO                          # DEBUG, INFO, WARNING, ERROR
LOG_DIR=./logs

# ---------------------------------------------------------------------------
# Not supported
# ---------------------------------------------------------------------------
# Unattended crawling of social platforms is not built. The worker-account
# machinery it needed — warm-up, follow pacing, proxy rotation, account lifecycle,
# CAPTCHA handoff — was written but never wired to anything, and has been removed
# rather than left looking available. Collection is human-driven: capture a thread
# with the Chrome extension (EXTENSION_ENABLED above) and the agent classifies it.
